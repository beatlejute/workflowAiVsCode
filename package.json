{
  "name": "workflow-vscode",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.1.0",
  "publisher": "workflow-ai",
  "license": "MIT",
  "icon": "assets/icon-128.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/workflow-ai/wf-vscode.git"
  },
  "keywords": [
    "workflow",
    "project-management",
    "kanban",
    "productivity",
    "task-management",
    "agile"
  ],
  "engines": {
    "vscode": "^1.109.0",
    "node": ">=18.0.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "l10n": "./l10n",
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "workflow-sidebar",
          "title": "%views.activitybar.workflow.title%",
          "icon": "assets/sidebar-icon.svg"
        }
      ],
      "panel": [
        {
          "id": "workflow-kanban",
          "title": "%views.panel.kanban.title%",
          "icon": "$(layout)"
        }
      ]
    },
    "views": {
      "workflow-sidebar": [
        {
          "id": "workflow-sidebar.pipeline",
          "name": "%views.sidebar.pipeline.name%",
          "when": "workflow.cliInstalled && workflow.workflowFound"
        },
        {
          "id": "workflow-sidebar.plans",
          "name": "%views.sidebar.plans.name%",
          "when": "workflow.cliInstalled && workflow.workflowFound"
        },
        {
          "id": "workflow-sidebar.tickets",
          "name": "%views.sidebar.tickets.name%",
          "when": "workflow.cliInstalled && workflow.workflowFound"
        },
        {
          "id": "workflow-sidebar.reports",
          "name": "%views.sidebar.reports.name%",
          "when": "workflow.cliInstalled && workflow.workflowFound"
        },
        {
          "id": "workflow-sidebar.logs",
          "name": "%views.sidebar.logs.name%",
          "when": "workflow.cliInstalled && workflow.workflowFound"
        },
        {
          "id": "workflow-sidebar.skills",
          "name": "%views.sidebar.skills.name%",
          "when": "workflow.cliInstalled && workflow.workflowFound"
        },
        {
          "id": "workflow-sidebar.welcome",
          "name": "%views.sidebar.welcome.name%",
          "when": "!workflow.cliInstalled || !workflow.workflowFound",
          "visibility": "visible"
        }
      ],
      "workflow-kanban": [
        {
          "id": "wf-kanban-backlog",
          "name": "%views.kanban.backlog.name%",
          "when": "workflow.cliInstalled && workflow.workflowFound"
        },
        {
          "id": "wf-kanban-ready",
          "name": "%views.kanban.ready.name%",
          "when": "workflow.cliInstalled && workflow.workflowFound"
        },
        {
          "id": "wf-kanban-in-progress",
          "name": "%views.kanban.inProgress.name%",
          "when": "workflow.cliInstalled && workflow.workflowFound"
        },
        {
          "id": "wf-kanban-review",
          "name": "%views.kanban.review.name%",
          "when": "workflow.cliInstalled && workflow.workflowFound"
        },
        {
          "id": "wf-kanban-done",
          "name": "%views.kanban.done.name%",
          "when": "workflow.cliInstalled && workflow.workflowFound"
        },
        {
          "id": "wf-kanban-blocked",
          "name": "%views.kanban.blocked.name%",
          "when": "workflow.cliInstalled && workflow.workflowFound"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "workflow-sidebar.welcome",
        "contents": "Workflow CLI is not installed.\n[Install workflow-ai](command:workflow.installCli)",
        "when": "!workflow.cliInstalled"
      },
      {
        "view": "workflow-sidebar.welcome",
        "contents": "Workflow directory not found.\n[Initialize Workflow](command:workflow.init)",
        "when": "workflow.cliInstalled && !workflow.workflowFound && workspaceFolderCount != 0"
      },
      {
        "view": "workflow-sidebar.welcome",
        "contents": "Open a folder to get started.\n[Open Folder](command:vscode.openFolder)",
        "when": "workspaceFolderCount == 0"
      }
    ],
    "commands": [
      {
        "command": "workflow.installCli",
        "title": "%command.installCli.title%",
        "category": "%category.workflow%"
      },
      {
        "command": "workflow.init",
        "title": "%command.init.title%",
        "category": "%category.workflow%"
      },
      {
        "command": "workflow.openTicket",
        "title": "%command.openTicket.title%",
        "category": "%category.workflow%",
        "icon": "$(file)"
      },
      {
        "command": "workflow.togglePlanTemplate",
        "title": "%command.togglePlanTemplate.title%",
        "category": "%category.workflow%",
        "icon": "$(toggle-on)"
      },
      {
        "command": "workflow.runPipeline",
        "title": "%command.runPipeline.title%",
        "category": "%category.workflow%",
        "icon": "$(play)"
      },
      {
        "command": "workflow.stopPipeline",
        "title": "%command.stopPipeline.title%",
        "category": "%category.workflow%",
        "icon": "$(debug-stop)"
      },
      {
        "command": "workflow.runPipelineForPlan",
        "title": "%command.runPipelineForPlan.title%",
        "category": "%category.workflow%",
        "icon": "$(play)"
      },
      {
        "command": "workflow.showPipelineOutput",
        "title": "%command.showPipelineOutput.title%",
        "category": "%category.workflow%",
        "icon": "$(output)"
      },
      {
        "command": "workflow.clearPipelineHistory",
        "title": "%command.clearPipelineHistory.title%",
        "category": "%category.workflow%",
        "icon": "$(clear-all)"
      },
      {
        "command": "workflow.openPipelineConfig",
        "title": "%command.openPipelineConfig.title%",
        "category": "%category.workflow%",
        "icon": "$(settings-gear)"
      },
      {
        "command": "workflow.openConfig",
        "title": "%command.openConfig.title%",
        "category": "%category.workflow%",
        "icon": "$(tools)"
      },
      {
        "command": "workflow.newTicket",
        "title": "%command.newTicket.title%",
        "category": "%category.workflow%",
        "icon": "$(add)"
      },
      {
        "command": "workflow.newPlan",
        "title": "%command.newPlan.title%",
        "category": "%category.workflow%",
        "icon": "$(new-file)"
      },
      {
        "command": "workflow.moveTicket",
        "title": "%command.moveTicket.title%",
        "category": "%category.workflow%"
      },
      {
        "command": "workflow.moveTicketNext",
        "title": "%command.moveTicketNext.title%",
        "category": "%category.workflow%",
        "icon": "$(arrow-right)"
      },
      {
        "command": "workflow.moveTicketFromMenu",
        "title": "%command.moveTicketFromMenu.title%",
        "category": "%category.workflow%"
      },
      {
        "command": "workflow.showTicketDependencies",
        "title": "%command.showTicketDependencies.title%",
        "category": "%category.workflow%"
      },
      {
        "command": "workflow.showDependencies",
        "title": "%command.showDependencies.title%",
        "category": "%category.workflow%"
      },
      {
        "command": "workflow.showStatistics",
        "title": "%command.showStatistics.title%",
        "category": "%category.workflow%"
      },
      {
        "command": "workflow.copyTicketId",
        "title": "%command.copyTicketId.title%",
        "category": "%category.workflow%"
      },
      {
        "command": "workflow.refreshTickets",
        "title": "%command.refreshTickets.title%",
        "category": "%category.workflow%",
        "icon": "$(refresh)"
      },
      {
        "command": "workflow.refreshAll",
        "title": "%command.refreshAll.title%",
        "category": "%category.workflow%",
        "icon": "$(refresh)"
      },
      {
        "command": "workflow.filterTicketsByPlan",
        "title": "%command.filterTicketsByPlan.title%",
        "category": "%category.workflow%",
        "icon": "$(filter)"
      },
      {
        "command": "workflow.clearTicketFilter",
        "title": "%command.clearTicketFilter.title%",
        "category": "%category.workflow%",
        "icon": "$(clear-all)"
      },
      {
        "command": "workflow.sortTicketsByPriority",
        "title": "%command.sortTicketsByPriority.title%",
        "category": "%category.workflow%"
      },
      {
        "command": "workflow.sortTicketsById",
        "title": "%command.sortTicketsById.title%",
        "category": "%category.workflow%"
      },
      {
        "command": "workflow.sortTicketsByTitle",
        "title": "%command.sortTicketsByTitle.title%",
        "category": "%category.workflow%"
      },
      {
        "command": "workflow.sortTicketsByDate",
        "title": "%command.sortTicketsByDate.title%",
        "category": "%category.workflow%"
      },
      {
        "command": "workflow.sortKanbanByPriority",
        "title": "%command.sortKanbanByPriority.title%",
        "category": "%category.workflow%"
      },
      {
        "command": "workflow.sortKanbanById",
        "title": "%command.sortKanbanById.title%",
        "category": "%category.workflow%"
      },
      {
        "command": "workflow.sortKanbanByTitle",
        "title": "%command.sortKanbanByTitle.title%",
        "category": "%category.workflow%"
      },
      {
        "command": "workflow.sortKanbanByDate",
        "title": "%command.sortKanbanByDate.title%",
        "category": "%category.workflow%"
      },
      {
        "command": "workflow.toggleSortDirection",
        "title": "%command.toggleSortDirection.title%",
        "category": "%category.workflow%",
        "icon": "$(arrow-up)"
      },
      {
        "command": "workflow.decomposePlan",
        "title": "%command.decomposePlan.title%",
        "category": "%category.workflow%"
      },
      {
        "command": "workflow.archivePlan",
        "title": "%command.archivePlan.title%",
        "category": "%category.workflow%"
      },
      {
        "command": "workflow.unarchivePlan",
        "title": "%command.unarchivePlan.title%",
        "category": "%category.workflow%"
      },
      {
        "command": "workflow.approvePlan",
        "title": "%command.approvePlan.title%",
        "category": "%category.workflow%"
      },
      {
        "command": "workflow.revertPlanToDraft",
        "title": "%command.revertPlanToDraft.title%",
        "category": "%category.workflow%"
      },
      {
        "command": "workflow.createPlanFromTemplate",
        "title": "%command.createPlanFromTemplate.title%",
        "category": "%category.workflow%"
      },
      {
        "command": "workflow.createPlanFromFile",
        "title": "%command.createPlanFromFile.title%",
        "category": "%category.workflow%"
      },
      {
        "command": "workflow.focusTicketsView",
        "title": "%command.focusTicketsView.title%",
        "category": "%category.workflow%"
      },
      {
        "command": "workflow.focusKanban",
        "title": "%command.focusKanban.title%",
        "category": "%category.workflow%"
      },
      {
        "command": "workflow.openHistoryLog",
        "title": "%command.openHistoryLog.title%",
        "category": "%category.workflow%"
      },
      {
        "command": "workflow.openHistoryPlan",
        "title": "%command.openHistoryPlan.title%",
        "category": "%category.workflow%"
      },
      {
        "command": "workflow.openStageTicket",
        "title": "%command.openStageTicket.title%",
        "category": "%category.workflow%"
      },
      {
        "command": "workflow.openStageLog",
        "title": "%command.openStageLog.title%",
        "category": "%category.workflow%"
      },
      {
        "command": "workflow.openStageReport",
        "title": "%command.openStageReport.title%",
        "category": "%category.workflow%"
      }
    ],
    "keybindings": [
      {
        "command": "workflow.runPipeline",
        "key": "ctrl+alt+w r",
        "when": "workflow.cliInstalled && workflow.workflowFound"
      },
      {
        "command": "workflow.newTicket",
        "key": "ctrl+alt+w n",
        "when": "workflow.cliInstalled && workflow.workflowFound"
      },
      {
        "command": "workflow.moveTicket",
        "key": "ctrl+alt+w m",
        "when": "workflow.cliInstalled && workflow.workflowFound"
      }
    ],
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "workflow.cliPath": {
          "type": "string",
          "default": "",
          "description": "%config.cliPath.description%"
        },
        "workflow.locale": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "en",
            "ru",
            "de",
            "fr",
            "es",
            "it",
            "pt",
            "zh",
            "ja",
            "ko"
          ],
          "enumDescriptions": [
            "%config.locale.enumDescriptions.auto%",
            "%config.locale.enumDescriptions.en%",
            "%config.locale.enumDescriptions.ru%",
            "%config.locale.enumDescriptions.de%",
            "%config.locale.enumDescriptions.fr%",
            "%config.locale.enumDescriptions.es%",
            "%config.locale.enumDescriptions.it%",
            "%config.locale.enumDescriptions.pt%",
            "%config.locale.enumDescriptions.zh%",
            "%config.locale.enumDescriptions.ja%",
            "%config.locale.enumDescriptions.ko%"
          ],
          "description": "%config.locale.description%"
        }
      }
    },
    "snippets": [
      {
        "language": "markdown",
        "path": "./snippets/workflow.code-snippets"
      },
      {
        "language": "yaml",
        "path": "./snippets/workflow.code-snippets"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "workflow.newTicket",
          "when": "view == workflow-sidebar.tickets && workflow.cliInstalled && workflow.workflowFound",
          "group": "navigation"
        },
        {
          "command": "workflow.refreshTickets",
          "when": "view == workflow-sidebar.tickets && workflow.cliInstalled && workflow.workflowFound",
          "group": "navigation"
        },
        {
          "command": "workflow.filterTicketsByPlan",
          "when": "view == workflow-sidebar.tickets && workflow.cliInstalled && workflow.workflowFound",
          "group": "navigation"
        },
        {
          "command": "workflow.clearTicketFilter",
          "when": "view == workflow-sidebar.tickets && workflow.cliInstalled && workflow.workflowFound && workflow.ticketFilterActive",
          "group": "navigation"
        },
        {
          "command": "workflow.sortTicketsByPriority",
          "when": "view == workflow-sidebar.tickets && workflow.cliInstalled && workflow.workflowFound",
          "group": "2_sort"
        },
        {
          "command": "workflow.sortTicketsById",
          "when": "view == workflow-sidebar.tickets && workflow.cliInstalled && workflow.workflowFound",
          "group": "2_sort"
        },
        {
          "command": "workflow.sortTicketsByTitle",
          "when": "view == workflow-sidebar.tickets && workflow.cliInstalled && workflow.workflowFound",
          "group": "2_sort"
        },
        {
          "command": "workflow.sortTicketsByDate",
          "when": "view == workflow-sidebar.tickets && workflow.cliInstalled && workflow.workflowFound",
          "group": "2_sort"
        },
        {
          "command": "workflow.toggleSortDirection",
          "when": "view == workflow-sidebar.tickets && workflow.cliInstalled && workflow.workflowFound",
          "group": "2_sort",
          "icon": "$(arrow-up)"
        },
        {
          "command": "workflow.newTicket",
          "when": "view =~ /^wf-kanban-/ && workflow.cliInstalled && workflow.workflowFound",
          "group": "navigation"
        },
        {
          "command": "workflow.refreshTickets",
          "when": "view =~ /^wf-kanban-/ && workflow.cliInstalled && workflow.workflowFound",
          "group": "navigation"
        },
        {
          "command": "workflow.sortKanbanByPriority",
          "when": "view =~ /^wf-kanban-/ && workflow.cliInstalled && workflow.workflowFound",
          "group": "2_sort"
        },
        {
          "command": "workflow.sortKanbanById",
          "when": "view =~ /^wf-kanban-/ && workflow.cliInstalled && workflow.workflowFound",
          "group": "2_sort"
        },
        {
          "command": "workflow.sortKanbanByTitle",
          "when": "view =~ /^wf-kanban-/ && workflow.cliInstalled && workflow.workflowFound",
          "group": "2_sort"
        },
        {
          "command": "workflow.sortKanbanByDate",
          "when": "view =~ /^wf-kanban-/ && workflow.cliInstalled && workflow.workflowFound",
          "group": "2_sort"
        },
        {
          "command": "workflow.toggleSortDirection",
          "when": "view =~ /^wf-kanban-/ && workflow.cliInstalled && workflow.workflowFound",
          "group": "2_sort",
          "icon": "$(arrow-up)"
        },
        {
          "command": "workflow.runPipeline",
          "when": "view == workflow-sidebar.pipeline && !workflow.pipelineRunning && workflow.cliInstalled && workflow.workflowFound",
          "group": "navigation"
        },
        {
          "command": "workflow.stopPipeline",
          "when": "view == workflow-sidebar.pipeline && workflow.pipelineRunning && workflow.cliInstalled && workflow.workflowFound",
          "group": "navigation"
        },
        {
          "command": "workflow.showPipelineOutput",
          "when": "view == workflow-sidebar.pipeline && workflow.cliInstalled && workflow.workflowFound",
          "group": "2_pipeline"
        },
        {
          "command": "workflow.clearPipelineHistory",
          "when": "view == workflow-sidebar.pipeline && workflow.cliInstalled && workflow.workflowFound",
          "group": "2_pipeline"
        },
        {
          "command": "workflow.openPipelineConfig",
          "when": "view == workflow-sidebar.pipeline && workflow.cliInstalled && workflow.workflowFound",
          "group": "2_pipeline"
        },
        {
          "command": "workflow.openConfig",
          "when": "view == workflow-sidebar.pipeline && workflow.cliInstalled && workflow.workflowFound",
          "group": "2_pipeline",
          "icon": "$(tools)"
        }
      ],
      "view/item/context": [
        {
          "command": "workflow.openTicket",
          "when": "view == workflow-sidebar.tickets && viewItem == ticket && workflow.cliInstalled && workflow.workflowFound",
          "group": "1_open"
        },
        {
          "command": "workflow.moveTicketNext",
          "when": "view == workflow-sidebar.tickets && viewItem == ticket && workflow.cliInstalled && workflow.workflowFound",
          "group": "inline"
        },
        {
          "command": "workflow.moveTicketFromMenu",
          "when": "view == workflow-sidebar.tickets && viewItem == ticket && workflow.cliInstalled && workflow.workflowFound",
          "group": "2_move"
        },
        {
          "command": "workflow.showTicketDependencies",
          "when": "view == workflow-sidebar.tickets && viewItem == ticket && workflow.cliInstalled && workflow.workflowFound",
          "group": "3_deps"
        },
        {
          "command": "workflow.copyTicketId",
          "when": "view == workflow-sidebar.tickets && viewItem == ticket && workflow.cliInstalled && workflow.workflowFound",
          "group": "4_copy"
        },
        {
          "command": "workflow.openTicket",
          "when": "view =~ /^wf-kanban-/ && viewItem == kanban-ticket && workflow.cliInstalled && workflow.workflowFound",
          "group": "1_open"
        },
        {
          "command": "workflow.moveTicketNext",
          "when": "view =~ /^wf-kanban-/ && viewItem == kanban-ticket && workflow.cliInstalled && workflow.workflowFound",
          "group": "inline"
        },
        {
          "command": "workflow.moveTicketFromMenu",
          "when": "view =~ /^wf-kanban-/ && viewItem == kanban-ticket && workflow.cliInstalled && workflow.workflowFound",
          "group": "2_move"
        },
        {
          "command": "workflow.showTicketDependencies",
          "when": "view =~ /^wf-kanban-/ && viewItem == kanban-ticket && workflow.cliInstalled && workflow.workflowFound",
          "group": "3_deps"
        },
        {
          "command": "workflow.copyTicketId",
          "when": "view =~ /^wf-kanban-/ && viewItem == kanban-ticket && workflow.cliInstalled && workflow.workflowFound",
          "group": "4_copy"
        },
        {
          "command": "workflow.decomposePlan",
          "when": "view == workflow-sidebar.plans && viewItem =~ /^plan-current/ && workflow.cliInstalled && workflow.workflowFound",
          "group": "1_actions"
        },
        {
          "command": "workflow.runPipelineForPlan",
          "when": "view == workflow-sidebar.plans && viewItem =~ /^plan-current/ && !workflow.pipelineRunning && workflow.cliInstalled && workflow.workflowFound",
          "group": "1_actions"
        },
        {
          "command": "workflow.archivePlan",
          "when": "view == workflow-sidebar.plans && viewItem =~ /^plan-current/ && workflow.cliInstalled && workflow.workflowFound",
          "group": "2_archive"
        },
        {
          "command": "workflow.unarchivePlan",
          "when": "view == workflow-sidebar.plans && viewItem == plan-archive && workflow.cliInstalled && workflow.workflowFound",
          "group": "2_archive"
        },
        {
          "command": "workflow.approvePlan",
          "when": "view == workflow-sidebar.plans && viewItem == plan-current-draft && workflow.cliInstalled && workflow.workflowFound",
          "group": "1_actions"
        },
        {
          "command": "workflow.revertPlanToDraft",
          "when": "view == workflow-sidebar.plans && viewItem == plan-current-approved && workflow.cliInstalled && workflow.workflowFound",
          "group": "1_actions"
        },
        {
          "command": "workflow.approvePlan",
          "when": "false"
        },
        {
          "command": "workflow.revertPlanToDraft",
          "when": "false"
        },
        {
          "command": "workflow.createPlanFromTemplate",
          "when": "view == workflow-sidebar.plans && viewItem =~ /^plan-template/ && workflow.cliInstalled && workflow.workflowFound",
          "group": "1_actions"
        },
        {
          "command": "workflow.createPlanFromTemplate",
          "when": "false"
        },
        {
          "command": "workflow.togglePlanTemplate",
          "when": "viewItem =~ /^plan-template/",
          "group": "inline"
        },
        {
          "command": "workflow.togglePlanTemplate",
          "when": "view == workflow-sidebar.plans && viewItem =~ /^plan-template/",
          "group": "1_actions"
        },
        {
          "command": "workflow.openHistoryLog",
          "when": "viewItem =~ /^history-item/",
          "group": "1_open"
        },
        {
          "command": "workflow.openHistoryPlan",
          "when": "viewItem == history-item-plan",
          "group": "1_open"
        },
        {
          "command": "workflow.openStageTicket",
          "when": "viewItem =~ /^completed-stage.*ticket/",
          "group": "1_open"
        },
        {
          "command": "workflow.openStageLog",
          "when": "viewItem =~ /^completed-stage/",
          "group": "2_log"
        },
        {
          "command": "workflow.openStageReport",
          "when": "viewItem =~ /^completed-stage-report/",
          "group": "1_open"
        }
      ],
      "commandPalette": [
        {
          "command": "workflow.init",
          "when": "!workflow.workflowFound"
        },
        {
          "command": "workflow.installCli",
          "when": "!workflow.cliInstalled"
        },
        {
          "command": "workflow.newTicket",
          "when": "workflow.cliInstalled && workflow.workflowFound"
        },
        {
          "command": "workflow.newPlan",
          "when": "workflow.cliInstalled && workflow.workflowFound"
        },
        {
          "command": "workflow.moveTicket",
          "when": "workflow.cliInstalled && workflow.workflowFound"
        },
        {
          "command": "workflow.showDependencies",
          "when": "workflow.cliInstalled && workflow.workflowFound"
        },
        {
          "command": "workflow.showStatistics",
          "when": "workflow.cliInstalled && workflow.workflowFound"
        },
        {
          "command": "workflow.openPipelineConfig",
          "when": "workflow.cliInstalled && workflow.workflowFound"
        },
        {
          "command": "workflow.openConfig",
          "when": "workflow.cliInstalled && workflow.workflowFound"
        },
        {
          "command": "workflow.focusTicketsView",
          "when": "workflow.cliInstalled && workflow.workflowFound"
        },
        {
          "command": "workflow.focusKanban",
          "when": "workflow.cliInstalled && workflow.workflowFound"
        },
        {
          "command": "workflow.refreshAll",
          "when": "workflow.cliInstalled && workflow.workflowFound"
        },
        {
          "command": "workflow.copyTicketId",
          "when": "workflow.cliInstalled && workflow.workflowFound"
        },
        {
          "command": "workflow.runPipeline",
          "when": "workflow.cliInstalled && workflow.workflowFound && !workflow.pipelineRunning"
        },
        {
          "command": "workflow.stopPipeline",
          "when": "workflow.cliInstalled && workflow.workflowFound && workflow.pipelineRunning"
        },
        {
          "command": "workflow.openHistoryLog",
          "when": "false"
        },
        {
          "command": "workflow.openHistoryPlan",
          "when": "false"
        },
        {
          "command": "workflow.openStageTicket",
          "when": "false"
        },
        {
          "command": "workflow.openStageLog",
          "when": "false"
        },
        {
          "command": "workflow.openStageReport",
          "when": "false"
        },
        {
          "command": "workflow.createPlanFromFile",
          "when": "false"
        }
      ]
    }
  },
