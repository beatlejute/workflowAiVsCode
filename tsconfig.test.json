{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "sourceMap": true,
    "outDir": "./dist/test",
    "rootDir": "./src",
    "declaration": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node", "mocha"]
  },
  "include": ["src/test/**/*.ts", "src/extension.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "src/test/unit/hover-provider.test.ts",
    "src/test/unit/completion-provider.test.ts"
  ]
}
