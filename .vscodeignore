out/
dist/unit-test/
coverage/
.nyc_output/
*.tsbuildinfo
.c8rc.json
tsconfig.unit-test.json
analyze-coverage.js
parse-coverage.js
compile-new-tests.mjs
run-coverage.sh
run-unit-tests.cmd
run-unit-tests.sh

# Отчёты пайплайна и дев-документация
reports/
DEVELOPMENT.md
CONTRIBUTING.md
.husky/

# Локальные песочницы инструментов: каталоги со своими node_modules,
